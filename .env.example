# Copiez ce fichier en `.env.local`. Tout est FACULTATIF : sans aucune de ces
# variables, le site tourne sur le catalogue de démo et les commandes
# s'affichent dans la console du serveur.

# --- Dashboard -------------------------------------------------------------
# Mot de passe unique pour accéder à /admin. Par défaut : "admin".
ADMIN_PASSWORD=changez-moi

# --- Supabase (catalogue + commandes) --------------------------------------
# Projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : côté serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (mail de commande) ---------------------------------------------
RESEND_API_KEY=
# L'adresse qui reçoit les commandes.
OWNER_EMAIL=
# Expéditeur : doit appartenir à un domaine vérifié dans Resend.
RESEND_FROM=commandes@votre-domaine.tn
